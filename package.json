{
  "name": "fomo-api",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:worker": "bun --watch src/apps/worker.ts",
    "start:worker": "bun src/apps/worker.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "openapi": "bun scripts/emit-openapi.ts",
    "helius:sync": "bun scripts/sync-helius-webhook.ts",
    "check": "bun run lint && bun run typecheck && bun run test",
    "dev:api": "bun --watch src/apps/api.ts",
    "start:api": "bun src/apps/api.ts",
    "dev:ws": "bun --watch src/apps/ws.ts",
    "start:ws": "bun src/apps/ws.ts",
    "dev:feed": "bun --watch src/apps/feed.ts",
    "start:feed": "bun src/apps/feed.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/bun": "^1.4.4",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "typescript": "5.9"
  },
  "dependencies": {
    "@hono/otel": "^1.3.0",
    "@hono/zod-openapi": "^1.6.3",
    "@hono/zod-validator": "^0.9.1",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-trace-base": "^2.12.1",
    "@opentelemetry/sdk-trace-node": "^2.12.1",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "@privy-io/node": "^0.41.0",
    "@scalar/hono-api-reference": "^0.12.22",
    "@solana/kit": "^8.6.0",
    "bullmq": "^6.7.7",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "ioredis": "^6.0.0",
    "jose": "^6.2.17",
    "pino": "^10.4.0",
    "postgres": "^4.1.1",
    "zod": "^4.6.7"
  },
  "version": "0.1.0",
  "packageManager": "bun@1.4.4"
}
