{
  "openapi": "3.1.0",
  "info": {
    "title": "fomo API",
    "version": "0.1.0",
    "description": "WebSocket /ws: subscribe with {\"op\":\"subscribe\",\"topic\":\"token:<mint>:price\"}. Events contain {type:\"event\",topic,data:PriceTick}; time is Unix seconds. Live price ticks poll every 5 seconds only for subscribed allowlisted mints. token:<mint>:trades is synthetic in mock mode only; live trades are available via REST with a Birdeye key."
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Privy access token"
      }
    },
    "schemas": {
      "PriceTick": {
        "type": "object",
        "properties": {
          "mint": {
            "type": "string"
          },
          "priceUsd": {
            "type": "number"
          },
          "marketCapUsd": {
            "type": "number"
          },
          "time": {
            "type": "integer",
            "description": "Unix seconds"
          }
        },
        "required": [
          "mint",
          "priceUsd",
          "marketCapUsd",
          "time"
        ]
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "uptimeSec": {
            "type": "number"
          },
          "marketData": {
            "type": "string",
            "enum": [
              "mock",
              "live"
            ]
          }
        },
        "required": [
          "status",
          "uptimeSec",
          "marketData"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "example": "not_found"
              },
              "message": {
                "type": "string"
              },
              "details": {}
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "Token": {
        "type": "object",
        "properties": {
          "mint": {
            "type": "string"
          },
          "symbol": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "decimals": {
            "type": "integer"
          },
          "imageUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "priceUsd": {
            "type": "number"
          },
          "priceChange24hPct": {
            "type": "number"
          },
          "marketCapUsd": {
            "type": "number"
          },
          "liquidityUsd": {
            "type": "number"
          },
          "volume24hUsd": {
            "type": "number"
          },
          "holders": {
            "type": "integer"
          }
        },
        "required": [
          "mint",
          "symbol",
          "name",
          "decimals",
          "imageUrl",
          "priceUsd",
          "priceChange24hPct",
          "marketCapUsd",
          "liquidityUsd",
          "volume24hUsd",
          "holders"
        ]
      },
      "Candle": {
        "type": "object",
        "properties": {
          "time": {
            "type": "integer",
            "description": "Bucket start, unix seconds"
          },
          "open": {
            "type": "number"
          },
          "high": {
            "type": "number"
          },
          "low": {
            "type": "number"
          },
          "close": {
            "type": "number"
          },
          "volume": {
            "type": "number"
          }
        },
        "required": [
          "time",
          "open",
          "high",
          "low",
          "close",
          "volume"
        ]
      },
      "Trade": {
        "type": "object",
        "properties": {
          "signature": {
            "type": "string"
          },
          "mint": {
            "type": "string"
          },
          "side": {
            "type": "string",
            "enum": [
              "buy",
              "sell"
            ]
          },
          "trader": {
            "type": "string"
          },
          "tokenAmount": {
            "type": "number"
          },
          "amountUsd": {
            "type": "number"
          },
          "priceUsd": {
            "type": "number"
          },
          "time": {
            "type": "integer"
          }
        },
        "required": [
          "signature",
          "mint",
          "side",
          "trader",
          "tokenAmount",
          "amountUsd",
          "priceUsd",
          "time"
        ]
      },
      "Me": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "privyDid": {
            "type": "string"
          },
          "walletAddress": {
            "type": [
              "string",
              "null"
            ]
          },
          "handle": {
            "type": [
              "string",
              "null"
            ]
          },
          "wallets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "address": {
                  "type": "string"
                },
                "chainType": {
                  "type": "string",
                  "enum": [
                    "solana"
                  ]
                },
                "walletClientType": {
                  "type": "string"
                },
                "privyWalletId": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "isPrimary": {
                  "type": "boolean"
                }
              },
              "required": [
                "address",
                "chainType",
                "walletClientType",
                "privyWalletId",
                "isPrimary"
              ]
            }
          }
        },
        "required": [
          "id",
          "privyDid",
          "walletAddress",
          "handle",
          "wallets"
        ]
      },
      "Portfolio": {
        "type": "object",
        "properties": {
          "equityUsd": {
            "type": "number"
          },
          "usdcBalance": {
            "type": "number"
          },
          "unrealizedPnlUsd": {
            "type": "number"
          },
          "realizedPnlUsd": {
            "type": "number"
          },
          "positions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "mint": {
                  "type": "string"
                },
                "symbol": {
                  "type": "string"
                },
                "quantity": {
                  "type": "number"
                },
                "avgCostUsd": {
                  "type": "number"
                },
                "priceUsd": {
                  "type": "number"
                },
                "valueUsd": {
                  "type": "number"
                },
                "unrealizedPnlUsd": {
                  "type": "number"
                },
                "realizedPnlUsd": {
                  "type": "number"
                }
              },
              "required": [
                "mint",
                "symbol",
                "quantity",
                "avgCostUsd",
                "priceUsd",
                "valueUsd",
                "unrealizedPnlUsd",
                "realizedPnlUsd"
              ]
            }
          }
        },
        "required": [
          "equityUsd",
          "usdcBalance",
          "unrealizedPnlUsd",
          "realizedPnlUsd",
          "positions"
        ]
      },
      "PortfolioHistory": {
        "type": "object",
        "properties": {
          "points": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "time": {
                  "type": "integer"
                },
                "valueUsd": {
                  "type": "number"
                }
              },
              "required": [
                "time",
                "valueUsd"
              ]
            }
          }
        },
        "required": [
          "points"
        ]
      },
      "UserTrade": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "signature": {
            "type": "string"
          },
          "mint": {
            "type": "string"
          },
          "symbol": {
            "type": "string"
          },
          "side": {
            "type": "string",
            "enum": [
              "buy",
              "sell"
            ]
          },
          "tokenAmount": {
            "type": "number"
          },
          "priceUsd": {
            "type": "number"
          },
          "valueUsd": {
            "type": "number"
          },
          "realizedPnlUsd": {
            "type": [
              "number",
              "null"
            ]
          },
          "time": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "signature",
          "mint",
          "symbol",
          "side",
          "tokenAmount",
          "priceUsd",
          "valueUsd",
          "realizedPnlUsd",
          "time"
        ]
      },
      "LeaderboardEntry": {
        "type": "object",
        "properties": {
          "rank": {
            "type": "integer"
          },
          "wallet": {
            "type": "string"
          },
          "handle": {
            "type": "string"
          },
          "pnlUsd": {
            "type": "number"
          },
          "pnlPct": {
            "type": "number"
          },
          "volumeUsd": {
            "type": "number"
          },
          "trades": {
            "type": "integer"
          },
          "winRatePct": {
            "type": "number"
          },
          "isFollowing": {
            "type": "boolean"
          }
        },
        "required": [
          "rank",
          "wallet",
          "handle",
          "pnlUsd",
          "pnlPct",
          "volumeUsd",
          "trades",
          "winRatePct"
        ]
      },
      "FeedItem": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "mint": {
                "type": "string"
              },
              "handle": {
                "type": "string"
              },
              "body": {
                "type": "string"
              },
              "position": {
                "type": "string",
                "enum": [
                  "long",
                  "short",
                  "none"
                ]
              },
              "createdAt": {
                "type": "integer",
                "description": "Unix seconds"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "thesis"
                ]
              },
              "wallet": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "mint",
              "handle",
              "body",
              "position",
              "createdAt",
              "kind",
              "wallet"
            ]
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "mint": {
                "type": "string"
              },
              "handle": {
                "type": "string"
              },
              "position": {
                "type": "string",
                "enum": [
                  "long",
                  "short",
                  "none"
                ]
              },
              "createdAt": {
                "type": "integer",
                "description": "Unix seconds"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "trade"
                ]
              },
              "wallet": {
                "type": "string"
              },
              "side": {
                "type": "string",
                "enum": [
                  "buy",
                  "sell"
                ]
              },
              "amountUsd": {
                "type": "number"
              }
            },
            "required": [
              "id",
              "mint",
              "handle",
              "position",
              "createdAt",
              "kind",
              "wallet",
              "side",
              "amountUsd"
            ]
          }
        ]
      },
      "Comment": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "mint": {
            "type": "string"
          },
          "handle": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "position": {
            "type": "string",
            "enum": [
              "long",
              "short",
              "none"
            ]
          },
          "likes": {
            "type": "integer"
          },
          "createdAt": {
            "type": "integer",
            "description": "Unix seconds"
          }
        },
        "required": [
          "id",
          "mint",
          "handle",
          "body",
          "position",
          "likes",
          "createdAt"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "system"
        ],
        "responses": {
          "200": {
            "description": "Liveness",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/v1/webhooks/helius": {
      "post": {
        "tags": [
          "webhooks"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "signature": {
                      "type": "string",
                      "minLength": 1
                    },
                    "timestamp": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "feePayer": {
                      "type": "string"
                    },
                    "fee": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "transactionError": {},
                    "accountData": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "account": {
                            "type": "string"
                          },
                          "nativeBalanceChange": {
                            "type": "integer",
                            "default": 0
                          },
                          "tokenBalanceChanges": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "userAccount": {
                                  "type": "string"
                                },
                                "mint": {
                                  "type": "string"
                                },
                                "rawTokenAmount": {
                                  "type": "object",
                                  "properties": {
                                    "tokenAmount": {
                                      "type": "string",
                                      "pattern": "^-?\\d+$"
                                    },
                                    "decimals": {
                                      "type": "integer",
                                      "minimum": 0,
                                      "maximum": 255
                                    }
                                  },
                                  "required": [
                                    "tokenAmount",
                                    "decimals"
                                  ],
                                  "additionalProperties": {}
                                }
                              },
                              "required": [
                                "userAccount",
                                "mint",
                                "rawTokenAmount"
                              ],
                              "additionalProperties": {}
                            },
                            "default": []
                          }
                        },
                        "required": [
                          "account"
                        ],
                        "additionalProperties": {}
                      }
                    }
                  },
                  "required": [
                    "signature",
                    "timestamp",
                    "feePayer",
                    "fee",
                    "accountData"
                  ],
                  "additionalProperties": {}
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Transactions processed; skipped includes duplicates and non-trades",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "indexed": {
                      "type": "integer"
                    },
                    "skipped": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "indexed",
                    "skipped"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid enhanced transactions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid webhook secret",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Webhook or SOL pricing unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/tokens/trending": {
      "get": {
        "tags": [
          "tokens"
        ],
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            },
            "required": false,
            "name": "limit",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Trending tokens",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "tokens": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Token"
                      }
                    }
                  },
                  "required": [
                    "tokens"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/tokens/{mint}": {
      "get": {
        "tags": [
          "tokens"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 32,
              "maxLength": 44,
              "example": "So11111111111111111111111111111111111111112"
            },
            "required": true,
            "name": "mint",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Token"
                }
              }
            }
          },
          "404": {
            "description": "Unknown token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/tokens/{mint}/candles": {
      "get": {
        "tags": [
          "tokens"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 32,
              "maxLength": 44,
              "example": "So11111111111111111111111111111111111111112"
            },
            "required": true,
            "name": "mint",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "1m",
                "5m",
                "15m",
                "1h",
                "4h",
                "1d"
              ],
              "default": "5m"
            },
            "required": false,
            "name": "interval",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 300
            },
            "required": false,
            "name": "limit",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "OHLCV candles, oldest first",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "candles": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Candle"
                      }
                    }
                  },
                  "required": [
                    "candles"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Unknown token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/tokens/{mint}/trades": {
      "get": {
        "tags": [
          "tokens"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 32,
              "maxLength": 44,
              "example": "So11111111111111111111111111111111111111112"
            },
            "required": true,
            "name": "mint",
            "in": "path"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            },
            "required": false,
            "name": "limit",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Recent trades, newest first",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "trades": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Trade"
                      }
                    }
                  },
                  "required": [
                    "trades"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Unknown token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/me": {
      "get": {
        "tags": [
          "users"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Authentication is not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/me/portfolio": {
      "get": {
        "tags": [
          "users"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current portfolio",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Portfolio"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Authentication is not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/me/portfolio/history": {
      "get": {
        "tags": [
          "users"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "7d",
                "30d",
                "all"
              ],
              "default": "7d"
            },
            "required": false,
            "name": "range",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Daily equity with final live point",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PortfolioHistory"
                }
              }
            }
          },
          "400": {
            "description": "Invalid range",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
