{
  "openapi": "3.1.0",
  "info": {
    "title": "fomo API",
    "version": "0.1.0"
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Privy access token"
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "uptimeSec": {
            "type": "number"
          }
        },
        "required": [
          "status",
          "uptimeSec"
        ]
      },
      "Token": {
        "type": "object",
        "properties": {
          "mint": {
            "type": "string"
          },
          "symbol": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "decimals": {
            "type": "integer"
          },
          "imageUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "priceUsd": {
            "type": "number"
          },
          "priceChange24hPct": {
            "type": "number"
          },
          "marketCapUsd": {
            "type": "number"
          },
          "liquidityUsd": {
            "type": "number"
          },
          "volume24hUsd": {
            "type": "number"
          },
          "holders": {
            "type": "integer"
          }
        },
        "required": [
          "mint",
          "symbol",
          "name",
          "decimals",
          "imageUrl",
          "priceUsd",
          "priceChange24hPct",
          "marketCapUsd",
          "liquidityUsd",
          "volume24hUsd",
          "holders"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "example": "not_found"
              },
              "message": {
                "type": "string"
              },
              "details": {}
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "Candle": {
        "type": "object",
        "properties": {
          "time": {
            "type": "integer",
            "description": "Bucket start, unix seconds"
          },
          "open": {
            "type": "number"
          },
          "high": {
            "type": "number"
          },
          "low": {
            "type": "number"
          },
          "close": {
            "type": "number"
          },
          "volume": {
            "type": "number"
          }
        },
        "required": [
          "time",
          "open",
          "high",
          "low",
          "close",
          "volume"
        ]
      },
      "Trade": {
        "type": "object",
        "properties": {
          "signature": {
            "type": "string"
          },
          "mint": {
            "type": "string"
          },
          "side": {
            "type": "string",
            "enum": [
              "buy",
              "sell"
            ]
          },
          "trader": {
            "type": "string"
          },
          "tokenAmount": {
            "type": "number"
          },
          "amountUsd": {
            "type": "number"
          },
          "priceUsd": {
            "type": "number"
          },
          "time": {
            "type": "integer"
          }
        },
        "required": [
          "signature",
          "mint",
          "side",
          "trader",
          "tokenAmount",
          "amountUsd",
          "priceUsd",
          "time"
        ]
      },
      "Me": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "privyDid": {
            "type": "string"
          },
          "walletAddress": {
            "type": [
              "string",
              "null"
            ]
          },
          "handle": {
            "type": [
              "string",
              "null"
            ]
          },
          "wallets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "address": {
                  "type": "string"
                },
                "chainType": {
                  "type": "string",
                  "enum": [
                    "solana"
                  ]
                },
                "walletClientType": {
                  "type": "string"
                },
                "privyWalletId": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "isPrimary": {
                  "type": "boolean"
                }
              },
              "required": [
                "address",
                "chainType",
                "walletClientType",
                "privyWalletId",
                "isPrimary"
              ]
            }
          }
        },
        "required": [
          "id",
          "privyDid",
          "walletAddress",
          "handle",
          "wallets"
        ]
      },
      "LeaderboardEntry": {
        "type": "object",
        "properties": {
          "rank": {
            "type": "integer"
          },
          "wallet": {
            "type": "string"
          },
          "handle": {
            "type": "string"
          },
          "pnlUsd": {
            "type": "number"
          },
          "pnlPct": {
            "type": "number"
          },
          "volumeUsd": {
            "type": "number"
          },
          "trades": {
            "type": "integer"
          },
          "winRatePct": {
            "type": "number"
          }
        },
        "required": [
          "rank",
          "wallet",
          "handle",
          "pnlUsd",
          "pnlPct",
          "volumeUsd",
          "trades",
          "winRatePct"
        ]
      },
      "Comment": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "mint": {
            "type": "string"
          },
          "handle": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "position": {
            "type": "string",
            "enum": [
              "long",
              "short",
              "none"
            ]
          },
          "likes": {
            "type": "integer"
          },
          "createdAt": {
            "type": "integer",
            "description": "Unix seconds"
          }
        },
        "required": [
          "id",
          "mint",
          "handle",
          "body",
          "position",
          "likes",
          "createdAt"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "system"
        ],
        "responses": {
          "200": {
            "description": "Liveness",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/v1/tokens/trending": {
      "get": {
        "tags": [
          "tokens"
        ],
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            },
            "required": false,
            "name": "limit",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Trending tokens",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "tokens": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Token"
                      }
                    }
                  },
                  "required": [
                    "tokens"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/tokens/{mint}": {
      "get": {
        "tags": [
          "tokens"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 32,
              "maxLength": 44,
              "example": "So11111111111111111111111111111111111111112"
            },
            "required": true,
            "name": "mint",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Token"
                }
              }
            }
          },
          "404": {
            "description": "Unknown token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/tokens/{mint}/candles": {
      "get": {
        "tags": [
          "tokens"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 32,
              "maxLength": 44,
              "example": "So11111111111111111111111111111111111111112"
            },
            "required": true,
            "name": "mint",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "1m",
                "5m",
                "15m",
                "1h",
                "4h",
                "1d"
              ],
              "default": "5m"
            },
            "required": false,
            "name": "interval",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 300
            },
            "required": false,
            "name": "limit",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "OHLCV candles, oldest first",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "candles": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Candle"
                      }
                    }
                  },
                  "required": [
                    "candles"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Unknown token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/tokens/{mint}/trades": {
      "get": {
        "tags": [
          "tokens"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 32,
              "maxLength": 44,
              "example": "So11111111111111111111111111111111111111112"
            },
            "required": true,
            "name": "mint",
            "in": "path"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            },
            "required": false,
            "name": "limit",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Recent trades, newest first",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "trades": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Trade"
                      }
                    }
                  },
                  "required": [
                    "trades"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Unknown token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/me": {
      "get": {
        "tags": [
          "users"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Authentication is not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/leaderboard": {
      "get": {
        "tags": [
          "social"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "24h",
                "7d",
                "30d"
              ],
              "default": "24h"
            },
            "required": false,
            "name": "window",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            },
            "required": false,
            "name": "limit",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Top traders by realized + unrealized PnL",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "window": {
                      "type": "string",
                      "enum": [
                        "24h",
                        "7d",
                        "30d"
                      ]
                    },
                    "entries": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/LeaderboardEntry"
                      }
                    }
                  },
                  "required": [
                    "window",
                    "entries"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/tokens/{mint}/comments": {
      "get": {
        "tags": [
          "social"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 32,
              "maxLength": 44,
              "example": "So11111111111111111111111111111111111111112"
            },
            "required": true,
            "name": "mint",
            "in": "path"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            },
            "required": false,
            "name": "limit",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Theses and comments on a token, newest first",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "comments": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Comment"
                      }
                    }
                  },
                  "required": [
                    "comments"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Unknown token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
