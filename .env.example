NODE_ENV=development
PORT=4000
WS_PORT=4001
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgres://fomo:fomo@localhost:5432/fomo
REDIS_URL=redis://localhost:6379

# Privy (dashboard.privy.io). Without it, authenticated routes return 503.
PRIVY_APP_ID=
# Optional: enables server-side Privy wallet linkage. Without it wallets stay unlinked.
PRIVY_APP_SECRET=
# Optional: pin the verification key instead of fetching JWKS.
PRIVY_VERIFICATION_KEY=

SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
HELIUS_API_KEY=
HELIUS_WEBHOOK_SECRET=
HELIUS_WEBHOOK_URL=
# Set both to use the finalized mainnet Yellowstone stream instead of demo chain events.
YELLOWSTONE_GRPC_URL=
YELLOWSTONE_GRPC_TOKEN=
JUPITER_API_KEY=
JUPITER_BASE_URL=https://api.jup.ag
# Development sponsorship also requires matching keys, live prices and referral config.
SPONSOR_ENABLED=false
FEE_PAYER_PUBKEY=
# Development only. Production must use a managed signer, never this variable.
FEE_PAYER_SECRET=
MAX_SLIPPAGE_BPS=300
MAX_PRICE_IMPACT_PCT=3
MAX_CU_PRICE_MICROLAMPORTS=2000000
MAX_LAMPORTS_PER_TX=10000000
DAILY_SPEND_CAP_SOL=1
# Jupiter referral project account (not the fee payer); both fields sent on build.
SPONSOR_REFERRAL_ACCOUNT=
SPONSOR_REFERRAL_FEE_BPS=50
BIRDEYE_API_KEY=

# Jupiter is keyless by default (lite-api.jup.ag); a key selects api.jup.ag.
# Birdeye candles/trades return 503 without BIRDEYE_API_KEY; never synthetic in live mode.
# Indexed trending by default. "live" requests Jupiter's trending list instead
# and is required when HELIUS_WEBHOOK_SECRET is set.
MARKET_DATA_PROVIDER=indexed
CHAIN_SOURCE=demo

OTEL_SERVICE_NAME=fomo-api
# e.g. http://localhost:4318 (docker compose jaeger)
OTEL_EXPORTER_OTLP_ENDPOINT=
