NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgres://fomo:fomo@localhost:5432/fomo
REDIS_URL=redis://localhost:6379

# Privy (dashboard.privy.io). Without it, authenticated routes return 503.
PRIVY_APP_ID=
# Optional: pin the verification key instead of fetching JWKS.
PRIVY_VERIFICATION_KEY=

SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
HELIUS_API_KEY=
JUPITER_API_KEY=
BIRDEYE_API_KEY=

# live = Jupiter metadata/prices; mock = deterministic offline data (including WS feed).
# Jupiter is keyless by default (lite-api.jup.ag); a key selects api.jup.ag.
# Birdeye candles/trades return 503 without BIRDEYE_API_KEY; never synthetic in live mode.
MARKET_DATA_PROVIDER=live
# Optional comma-separated curated mints; unset uses the eight mock seed mints.
MARKET_TOKEN_ALLOWLIST=
# Only effective when MARKET_DATA_PROVIDER=mock.
ENABLE_MOCK_FEED=true

OTEL_SERVICE_NAME=fomo-api
# e.g. http://localhost:4318 (docker compose jaeger)
OTEL_EXPORTER_OTLP_ENDPOINT=
